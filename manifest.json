{
  "manifest_version": 3,
  "name": "LeetCode AI Helper",
  "version": "2.1",
  "description": "AI-powered LeetCode assistant with progress tracking, hints, and personalized learning",
  "permissions": ["storage", "activeTab", "identity", "alarms", "scripting", "tabs"],
  "host_permissions": ["https://leetcode.com/*", "https://*.vercel.app/*", "http://localhost:*/*", "https://*.aistudio.google.com/*"],
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["auth.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
